# AutoShorts 2.0 — Environment Variables (optional overrides)
# Copy to .env and fill in values as needed.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Paths (override config.yaml)
# INPUT_DIR=input
# OUTPUT_DIR=output
# TEMP_DIR=temp

# Logging
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8899
